<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FPMCI · First-Person Mouse Control Integration" Width="1160" Height="860" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen"
 Background="#E7EFF2" Foreground="#142F3C" FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#496878"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#F4F8FA"/><Setter Property="Foreground" Value="#142F3C"/><Setter Property="BorderBrush" Value="#8EB7C9"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="40"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D4E6EE"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#142F3C"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".42"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#086E89"/></MultiTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Tag" Value="primary"><Setter Property="Background" Value="#087F9F"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#087F9F"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Nav" TargetType="Button">
   <Setter Property="Foreground" Value="#496878"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,2,0,2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid>
    <Path x:Name="NavPanel" Data="M0,0 L200,0 L188,44 L0,44 Z" Fill="{TemplateBinding Background}" Stretch="Fill"/>
    <ContentPresenter Margin="18,0,24,0" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavPanel" Property="Fill" Value="#C9DEE7"/></Trigger>
    <Trigger Property="Tag" Value="selected"><Setter Property="Foreground" Value="#FFFFFF"/><Setter TargetName="NavPanel" Property="Fill" Value="#087F9F"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavPanel" Property="Stroke" Value="#142F3C"/><Setter TargetName="NavPanel" Property="StrokeThickness" Value="1"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#F8FBFC"/><Setter Property="Foreground" Value="#142F3C"/><Setter Property="CaretBrush" Value="#087F9F"/>
   <Setter Property="BorderBrush" Value="#8EB7C9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,9"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#B0D6E6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1">
     <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#087F9F"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#142F3C"/><Setter Property="Background" Value="#F4F8FA"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#D4E6EE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#087F9F"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#142F3C"/><Setter Property="Background" Value="#F8FBFC"/><Setter Property="BorderBrush" Value="#8EB7C9"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="SelectEdge" Background="#F8FBFC" BorderBrush="{Binding BorderBrush,RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="1">
      <Path Data="M 0,0 L 5,5 L 10,0" Stroke="#496878" StrokeThickness="1.5" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
     </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectEdge" Property="BorderBrush" Value="#087F9F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Margin="12,8,32,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="#F4F8FA" BorderBrush="#8EB7C9" BorderThickness="1" CornerRadius="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#087F9F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#142F3C"/><Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#C9DCE5" BorderBrush="#648B9F" BorderThickness="1" VerticalAlignment="Center">
     <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#142F3C" HorizontalAlignment="Left" Margin="3,0,0,0"/>
    </Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#087F9F"/><Setter TargetName="Track" Property="BorderBrush" Value="#087F9F"/><Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#142F3C"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Foreground" Value="#087F9F"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center">
    <Border Height="3" Background="#A5C4D2" CornerRadius="1"/>
    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#087F9F" CornerRadius="1"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="16" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" Background="#F8FBFC" CornerRadius="1" BorderBrush="#087F9F" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#087F9F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#087F9F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#DCE7EC"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}">
     <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollHandle" Background="#86B2C3" CornerRadius="1" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollHandle" Property="Background" Value="#496878"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HeaderLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#496878"/></Style>
  <Style x:Key="HeaderValue" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
 </Window.Resources>
 <Grid Background="#E7EFF2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#DCE7EC" BorderBrush="#BED3DD" BorderThickness="0,0,1,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="22,26,20,24">
     <StackPanel Orientation="Horizontal"><Canvas Width="30" Height="44" Margin="0,0,10,0">
      <Path Stroke="#087F9F" StrokeThickness="1.5" Data="M15,8 L15,14 M15,34 L15,40 M0,24 L6,24 M24,24 L30,24 M15,14 A10,10 0 1 1 14.99,14"/>
      <Path Fill="#087F9F" Data="M12,20 L24,30 L17,31 L14,37 Z"/>
     </Canvas><TextBlock x:Name="ModName" Text="FPMCI" FontFamily="Bahnschrift SemiCondensed" FontSize="48" FontWeight="Bold"/></StackPanel>
     <TextBlock Text="FIRST-PERSON MOUSE&#10;CONTROL INTEGRATION" FontFamily="Bahnschrift SemiCondensed" FontSize="12" LineHeight="17" Foreground="#496878" Margin="0,8,0,0"/>
     <TextBlock Text="第一人称鼠标操控整合" FontSize="11" Foreground="#496878" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0"><StackPanel x:Name="Navigation"/></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="22,18,22,20">
     <TextBlock Text="MOD 文件夹" FontSize="10" Foreground="#496878"/>
     <TextBlock x:Name="PackageName" Text="正在读取…" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,6,0,12"/>
     <Button x:Name="ChoosePackage" Content="切换文件夹" Padding="10,7" MinHeight="32" FontSize="12"/>
     <Button x:Name="Reload" Content="重新读取配置" Padding="10,7" MinHeight="32" FontSize="12" Margin="0,7,0,0"/>
     <TextBlock x:Name="VersionText" Foreground="#496878" FontFamily="Bahnschrift SemiCondensed" FontSize="11" Margin="0,14,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="#BED3DD" BorderThickness="0,0,0,1" Background="#DDEAF0">
    <UniformGrid Columns="4">
     <Border BorderBrush="#BED3DD" BorderThickness="0,0,1,0" Padding="24,11"><StackPanel><TextBlock Text="GAME" Style="{StaticResource HeaderLabel}"/><TextBlock x:Name="HeaderGame" Text="待定位" Style="{StaticResource HeaderValue}"/></StackPanel></Border>
     <Border BorderBrush="#BED3DD" BorderThickness="0,0,1,0" Padding="24,11"><StackPanel><TextBlock Text="MOD MODE" Style="{StaticResource HeaderLabel}"/><TextBlock x:Name="HeaderMode" Text="—" Style="{StaticResource HeaderValue}"/></StackPanel></Border>
     <Border BorderBrush="#BED3DD" BorderThickness="0,0,1,0" Padding="24,11"><StackPanel><TextBlock Text="PROFILE" Style="{StaticResource HeaderLabel}"/><TextBlock x:Name="HeaderProfile" Text="—" Style="{StaticResource HeaderValue}"/></StackPanel></Border>
     <Border Padding="24,11"><StackPanel><TextBlock Text="VERSION" Style="{StaticResource HeaderLabel}"/><TextBlock x:Name="HeaderVersion" Text="—" Style="{StaticResource HeaderValue}"/></StackPanel></Border>
    </UniformGrid>
   </Border>
   <Grid Grid.Row="1" Margin="30,23,30,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="PageCode" Text="INSTALL &amp; LAUNCH" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="34"/>
     <TextBlock x:Name="PageTitle" Text="安装与启动" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="18,0,0,4"/></StackPanel>
    <TextBlock x:Name="PageDescription" Grid.Row="1" Foreground="#496878" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
    <Grid Grid.Row="2" Height="2" Margin="0,18,0,0"><Border Height="1" Background="#BED3DD" VerticalAlignment="Bottom"/><Border Width="64" Background="#087F9F" HorizontalAlignment="Left"/></Grid>
   </Grid>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,6,30,24"><StackPanel x:Name="PageBody"/></ScrollViewer>
   <Border Grid.Row="3" BorderBrush="#BED3DD" BorderThickness="0,1,0,0" Background="#DDEAF0" Padding="24,12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Text="读取配置中…" Foreground="#496878" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <StackPanel x:Name="SettingTools" Grid.Column="1" Orientation="Horizontal">
       <Button x:Name="PageDefaults" Content="本页默认" Padding="9,5" MinHeight="28" FontSize="11"/>
       <Button x:Name="RestoreBackup" Content="恢复最近备份" Margin="7,0,0,0" Padding="9,5" MinHeight="28" FontSize="11"/>
       <TextBlock x:Name="FooterHint" Text="下次启动生效" Foreground="#496878" VerticalAlignment="Center" FontSize="10" Margin="10,0,0,0"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="Save" Content="保存设置" MinWidth="104" Padding="14,9" BorderBrush="#087F9F"/>
      <CheckBox x:Name="SteamLaunch" Grid.Column="1" Content="从 Steam 启动" IsChecked="True" FontSize="13" Margin="18,0,12,0" VerticalAlignment="Center" ToolTip="关闭后直接运行 MOD 会话启动流程，需要 Steam 已运行。"/>
      <Button x:Name="StartGame" Grid.Column="3" Content="开始游戏" Tag="primary" MinWidth="168" FontSize="15" Padding="24,11"/>
     </Grid>
     <ProgressBar x:Name="Busy" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" Height="2" Foreground="#087F9F" Background="#BED3DD" Margin="0,10,0,0"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
